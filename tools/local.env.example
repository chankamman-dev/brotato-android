# Copy to tools/local.env (not in the repository) and point these at your machine.
# The build scripts source it; paths are Git Bash style.

# Large files: Godot editor and templates, shell APKs, built APKs.
BROTATO_WORK=/e/android-recompile-work/brotato-android-work
# Steam install of Brotato (only Brotato.pck's header is read when building).
GAME_DIR="/c/Program Files (x86)/Steam/steamapps/common/Brotato"
# JDK 17.
JDK_HOME="/c/Program Files/Eclipse Adoptium/jdk-17"
# Android SDK with build-tools 36.0.0 and platforms/android-35 (d8, android.jar).
ANDROID_SDK=/c/Android/sdk
# build-tools used for zipalign and apksigner (34.0.0 works).
BUILD_TOOLS=/c/Android/sdk/build-tools/34.0.0
# apktool 3.x jar.
APKTOOL_JAR=C:/tools/apktool.jar
# Optional: a folder with JavaSteam and its dependency jars, copied when $BROTATO_WORK/steam/deps is missing.
JAVASTEAM_DEPS=
